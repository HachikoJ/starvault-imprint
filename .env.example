# Copy to .env and fill locally. Never commit real tokens.
PORT=4173
HOST=127.0.0.1
GITHUB_TOKEN=
TAVILY_API_KEY=
EXA_API_KEY=

# Local Node storage. Existing data/store.json is imported once and retained.
STORE_PATH=data/starvault.db

# Optional shared secret. When set, every /api/ request must carry it
# (Authorization: Bearer <token>, X-Api-Key, or sv_token cookie).
# Leave blank for localhost-only use. Required if you bind HOST=0.0.0.0.
AUTH_TOKEN=

# Exact public HTTPS origin when served behind a reverse proxy.
PUBLIC_ORIGIN=
# Trust X-Forwarded-For/Host/Proto only behind a proxy you control.
TRUST_PROXY=0
# Disabled by default to prevent model-provider SSRF into local/private networks.
ALLOW_PRIVATE_PROVIDER_URLS=0

# Daily automatic scan hour in local server time, 0-23.
SCAN_HOUR=8
# IANA timezone used for the persisted daily schedule.
APP_TIME_ZONE=Asia/Shanghai

# How many repositories to keep from one broad scan.
SCAN_MAX_REPOS=800

# Number of GitHub search pages per query profile.
GITHUB_SEARCH_PAGES=2

# Number of repositories to refresh daily Star/Fork trend cache for.
GITHUB_TREND_LIMIT=80

# Number of repositories to read from GitHub Trending as auxiliary signals.
GITHUB_TRENDING_MAX_REPOS=60
GITHUB_TRENDING_PER_PERIOD=25

# Use 1 to run a scan shortly after server boot.
RUN_SCAN_ON_BOOT=0
